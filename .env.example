# ---------------- Gemini (agent service) ----------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Flash-Lite models have a much higher free daily limit than the bigger Flash models.
# Run `python scripts/list_models.py` to see the model IDs your key can use.
GEMINI_MODEL=gemini-3.5-flash-lite
# Minimum seconds between LLM calls (protects the free-tier per-minute limit)
GEMINI_MIN_INTERVAL_S=5

# ---------------- Sandbox ----------------
SANDBOX_IMAGE=datapilot-sandbox

# ---------------- Shared secret between the gateway and the agent service ----------------
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
INTERNAL_API_KEY=

# ---------------- Agent service (FastAPI) ----------------
MAX_UPLOAD_MB=50
MAX_CONCURRENT_RUNS=1

# ---------------- Gateway (Express) ----------------
GATEWAY_PORT=4000
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# "mongo" (default) or "memory" (no database needed; users and history vanish on restart)
STORE=mongo
MONGODB_URI=mongodb://127.0.0.1:27017/datapilot
AGENT_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MAX_ACTIVE_RUNS_PER_USER=1
DAILY_RUN_LIMIT=20
